# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# Variables are added milestone by milestone; nothing is needed for M0–M2.

# ── Supabase (M3) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin / ops (M3–M4) ────────────────────────────────
ADMIN_EMAIL=
CRON_SECRET=
DRAFT_PREVIEW_SECRET=

# ── LLMs (M8–M9) ───────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
