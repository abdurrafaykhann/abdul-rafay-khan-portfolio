# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# The same variables go into Vercel → Project → Settings → Environment Variables
# (except SUPABASE_DB_URL, which is only used locally by `npm run db:apply`).

# ── Supabase (M3) ──────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (URI). Local use only.
SUPABASE_DB_URL=

# ── Admin / ops (M3–M4) ────────────────────────────────
# The only email allowed to sign in to /admin
ADMIN_EMAIL=
# Any long random strings (e.g. `openssl rand -hex 32`)
CRON_SECRET=
DRAFT_PREVIEW_SECRET=

# ── LLMs (M8–M9) ───────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
